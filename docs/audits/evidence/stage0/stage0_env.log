# env precedence
$ env -u AURORA_REGISTRY_PATH -u AWB_REGISTRY_PATH AURORA_REGISTRY_PATH=/a AWB_REGISTRY_PATH=/b -> registry_path:
/a
$ env -u AURORA_REGISTRY_PATH -u AWB_REGISTRY_PATH AWB_REGISTRY_PATH=/b -> registry_path:
/b
$ env -u AURORA_REGISTRY_PATH -u AWB_REGISTRY_PATH AURORA_REGISTRY_PATH= AWB_REGISTRY_PATH=/b -> registry_path:
/b
$ env -u AURORA_REGISTRY_PATH -u AWB_REGISTRY_PATH AURORA_REGISTRY_PATH= -> registry_path:
